# are handed, so they live in the repo and are versioned with the manifest.
dist/*
!dist/testmu-jmeter-studio-*.zip

# Recordings and run output: per-person, and often carrying real session data
*.har
*.jtl
*.jmx
!sample/*.jmx
jmeter.log
report/

.DS_Store
__pycache__/

# Working notes and agent tooling - not part of the product
.claude/
