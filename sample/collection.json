{
  "info": {
    "name": "DummyJSON sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"emilys\", \"password\": \"emilyspass\", \"expiresInMins\": 30}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://dummyjson.com/products/search?q=phone",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "phone"
                }
              ]
            }
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "https://dummyjson.com/carts/1",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "carts",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}